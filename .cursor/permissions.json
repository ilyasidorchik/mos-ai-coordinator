{
  // Auto-approve /telegram publish path (Upload-Post MCP).
  // mcpAllowlist replaces the in-app MCP allowlist for this workspace.
  "mcpAllowlist": [
    "upload-post:create_media_upload",
    "upload-post:complete_media_upload",
    "upload-post:upload_photos",
    "user-upload-post:create_media_upload",
    "user-upload-post:complete_media_upload",
    "user-upload-post:upload_photos"
  ],
  "autoRun": {
    "allow_instructions": [
      "When the user invoked /telegram or asked to post a case response result to the Telegram channel, allow Upload-Post MCP tools create_media_upload, complete_media_upload, and upload_photos for the Upload-Post profile from project .env (UPLOAD_POST_USER) / platform telegram.",
      "When publishing via /telegram, allow shell curl PUT of a local response JPEG to the Cloudflare R2 upload_url returned by create_media_upload (Content-Type image/jpeg, --data-binary)."
    ]
  }
}
