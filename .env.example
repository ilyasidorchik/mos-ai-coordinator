# Локальный конфиг для /telegram и /mail-inbox (копируем как .env и заполняем)

# --- Telegram ---
# В Cloud Agents (телефон / веб) те же ключи задаём на cursor.com → Cloud Agents → ··· → Secrets как Runtime Secret

# Токен бота, полученный от @BotFather
TELEGRAM_BOT_TOKEN=

# Телеграм-канал: @username или числовой id (например, -1001234567890, узнаётся через @userinfobot)
TELEGRAM_CHAT_ID=

# Публичный username канала без @ (для ссылок на пост: https://t.me/<name>/<post_id>)
# Задаём ключ для Cloud как Environment Variable
TELEGRAM_CHANNEL_USERNAME=


# --- Gmail ---
# OAuth client из Google Cloud (тип Desktop / installed). App может оставаться в Testing;
# тогда refresh-токен живёт ≈7 дней — обновить: node .codex/skills/mail-inbox/scripts/auth.mjs
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
# Необязательно; по умолчанию Mos Responses. Processed
# GMAIL_PROCESSED_LABEL=Mos Responses. Processed

# Если не хочется публично выставлять персональные данные
PERSONAL_DATA=Иванов*|Иванович*|Иван|Ивана|Ивану|Ивана|Иваном|ivan@ivanov.ru
