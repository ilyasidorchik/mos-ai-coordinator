# Local config for /telegram (copy to .env and fill in).
# Bot token and chat_id live in Upload-Post / Cursor MCP — not here.

# Upload-Post profile username (field `user` in upload_photos)
UPLOAD_POST_USER=

# Public Telegram channel username without @ (for post links: https://t.me/<name>/<post_id>)
TELEGRAM_CHANNEL_USERNAME=
